<mxfile host="app.diagrams.net" type="device"><diagram id="04-flow-dataset-registration" name="04 · Flow: dataset registration (upload, sample import, CLI)"><mxGraphModel dx="930" dy="1136" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="930" pageHeight="1136" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;04 · Flow: dataset registration (upload, sample import, CLI)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="900" height="30" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;POST /api/datasets (multipart file, name?)&lt;/b&gt;&lt;br&gt;or POST /api/datasets/samples/{sample}&lt;br&gt;or persistedReplay CLI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="320" height="70" as="geometry"/></mxCell><mxCell id="big" value="over 20 MB → 413 UPLOAD_TOO_LARGE&lt;br&gt;(lazy multipart, ConsoleExceptionHandler)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="30" width="220" height="50" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;file empty?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="140" height="80" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;400 DATASET_INVALID&lt;/b&gt;&lt;br&gt;EmptyDatasetUploadException" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="135" width="220" height="50" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;ReplayDatasetCatalogService.register&lt;/b&gt;&lt;br&gt;name trimmed, 1..128 chars" style="rounded=1;whiteSpace=wrap;html=1