<mxfile host="app.diagrams.net" type="device"><diagram id="17-integrations" name="17 · Integrations: APIs, database, RPC, files, schedulers, messaging"><mxGraphModel dx="1140" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;17 · Integrations: APIs, database, RPC, files, schedulers, messaging&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="900" height="30" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b&gt;React console&lt;/b&gt;&lt;br&gt;polls /api/dashboard every 5 s&lt;br&gt;Vite dev proxy → :8081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="240" height="80" as="geometry"/></mxCell><mxCell id="postman" value="&lt;b&gt;Postman / Newman&lt;/b&gt;&lt;br&gt;collections in postman/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="240" height="60" as="geometry"/></mxCell><mxCell id="term" value="&lt;b&gt;Terminal (Gradle JavaExec)&lt;/b&gt;&lt;br&gt;replay &amp;middot; persistedReplay&lt;br&gt;captureWalletHistory &amp;middot; inspectWalletHistory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="240" height="80" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;build replay &amp;middot; npm lint / test / build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="240" height="60" as="geometry"/></mxCell><mxCell id="act" value="&lt;b&gt;Actuator&lt;/b&gt;&lt;br&gt;health (liveness, readiness, db) &amp;middot; info&lt;br&gt;no metrics or Prometheus endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="300" height="70" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;trenching-bot&lt;/b&gt;&lt;br&gt;Spring Boot web app + CLI processes&lt;br&gt;&lt;br&gt;no Kafka &amp;middot; no message broker&lt;br&gt;no @Scheduled jobs &amp;middot; no cache server&lt;br&gt;every call is synchronous" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#3b5fa8;strokeWidth=2;arcSize=6;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="300" height="170" as="geometry"/></mxCell><mxCell id="meter" value="&lt;b&gt;Micrometer (in-process registry)&lt;/b&gt;&lt;br&gt;trenching.replay.runs &amp;middot; replay.duration&lt;br&gt;datasets.uploads &amp;middot; solana.probe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="300" height="70" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;Environment configuration (read at start)&lt;/b&gt;&lt;br&gt;SOLANA_RPC_URL (secret)&lt;br&gt;DATABASE_URL / _USERNAME / _PASSWORD&lt;br&gt;SPRING_PROFILES_ACTIVE &amp;middot; TRENCHING_CONSOLE_ENABLED" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#c9b458;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="470" width="300" height="90" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;Hikari JDBC &amp;middot; ddl-auto update (local, test)&lt;br&gt;validate (prod) &amp;middot; hand-applied SQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="20" width="280" height="90" as="geometry"/></mxCell><mxCell id="rpc1" value="&lt;b&gt;Solana RPC &amp;middot; console probe&lt;/b&gt;&lt;br&gt;getHealth &amp;middot; getVersion &amp;middot; getSlot&lt;br&gt;getGenesisHash &amp;middot; getTransaction&lt;br&gt;getSignaturesForAddress (limit 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="280" height="100" as="geometry"/></mxCell><mxCell id="rpc2" value="&lt;b&gt;Solana RPC &amp;middot; wallet capture (Helius)&lt;/b&gt;&lt;br&gt;getGenesisHash &amp;middot; getTransaction&lt;br&gt;getSignaturesForAddress (limit 1000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="780" y="270" width="280" height="90" as="geometry"/></mxCell><mxCell id="fs" value="&lt;b&gt;Filesystem&lt;/b&gt;&lt;br&gt;samples &amp;middot; reports &amp;middot; captures/&lt;br&gt;manifest.json + transactions/*.json" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="780" y="390" width="280" height="80" as="geometry"/></mxCell><mxCell id="edge0" value="REST /api/**" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="spa" target="app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="/actuator/health" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="spa" target="act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="REST + actuator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="postman" target="app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="main() entry points" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="term" target="app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="build + tests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="act" target="app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="counters &amp;middot; timers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="meter"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="JPA &amp;middot; one TX per run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="no retry &amp;middot; 30 s cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="rpc1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="3 attempts &amp;middot; budgets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a6a00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="rpc2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="atomic writes &amp;middot; SHA-256" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="app" target="fs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>