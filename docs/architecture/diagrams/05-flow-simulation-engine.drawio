<mxfile host="app.diagrams.net" type="device"><diagram id="05-flow-simulation-engine" name="05 · Flow: ReplayRunner simulation engine (pure, no I/O)"><mxGraphModel dx="1000" dy="1466" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1466" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;05 · Flow: ReplayRunner simulation engine (pure, no I/O)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="900" height="30" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;ReplayRunner.run(dataset, config)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="260" height="50" as="geometry"/></mxCell><mxCell id="s2" value="Canonicalize transactions (dedupe signature:instruction)&lt;br&gt;index observations per pair (binary search)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="95" width="360" height="60" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Identities&lt;/b&gt;&lt;br&gt;datasetHash = DatasetFingerprint &amp;middot; configHash = StableHash(config, scales, offsets)&lt;br&gt;runId = StableHash(&amp;quot;fixture-paper-v2&amp;quot;, datasetHash, configHash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="150" y="175" width="460" height="76" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;WalletNormalizer accepts?&lt;/b&gt;&lt;br&gt;successful &amp;middot; tracked wallet &amp;middot; signer &amp;middot; confirmed&lt;br&gt;route &amp;middot; quote mint &amp;middot; opposing deltas" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="275" width="260" height="120" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;Ignored(reason)&lt;/b&gt;&lt;br&gt;FAILED &amp;middot; OTHER_WALLET &amp;middot; NOT_SIGNER&lt;br&gt;NOT_CONFIRMED &amp;middot; UNSUPPORTED_ROUTE&lt;br&gt;UNSUPPORTED_QUOTE &amp;middot; INVALID_DELTAS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="280" height="90" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;side = BUY?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="425" width="120" height="70" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;Accepted SELL: stored, no intent&lt;/b&gt;&lt;br&gt;sells never force an exit" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#c9b458;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="432" width="280" height="56" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b&gt;CopyBuyStrategy → 3 TradeIntents&lt;/b&gt;&lt;br&gt;target slot = source +1 / +2 / +3 &amp;middot; notional from config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="525" width="320" height="60" as="geometry"/></mxCell><mxCell id="s7" value="Sort intents by (targetSlot, id) &amp;middot; for each intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="610" width="320" height="46" as="geometry"/></mxCell><mxCell id="s8" value="&lt;b&gt;Entry observation eligible?&lt;/b&gt;&lt;br&gt;first in [target, target + maxWait]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="685" width="260" height="100" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Rejected order&lt;/b&gt;&lt;br&gt;MISSING_OBSERVATION &amp;middot; INVALID_QUALITY&lt;br&gt;STALE_OBSERVATION &amp;middot; INSUFFICIENT_LIQUIDITY&lt;br&gt;ZERO_QUANTITY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="695" width="280" height="80" as="geometry"/></mxCell><mxCell id="s9" value="&lt;b&gt;FillModel&lt;/b&gt;&lt;br&gt;price = obs × (1 + slippage), scale 38&lt;br&gt;qty = notional ÷ price, scale 12 &amp;middot; fee = notional × feeBps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="815" width="360" height="66" as="geometry"/></mxCell><mxCell id="s10" value="&lt;b&gt;Overlaps latest position&lt;/b&gt;&lt;br&gt;of (pair, offset)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="910" width="220" height="90" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Rejected: ALREADY_OPEN&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="930" width="220" height="50" as="geometry"/></mxCell><mxCell id="s11" value="&lt;b&gt;PositionService.open → OPEN&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="1030" width="240" height="46" as="geometry"/></mxCell><mxCell id="s12" value="&lt;b&gt;Exit observation eligible?&lt;/b&gt;&lt;br&gt;first in [fill slot + holdingSlots,&lt;br&gt;+ maxWait]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1105" width="260" height="100" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Stays OPEN&lt;/b&gt;&lt;br&gt;exitUnavailable = reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="1125" width="240" height="60" as="geometry"/></mxCell><mxCell id="s13" value="&lt;b&gt;CLOSED &amp;middot; MAX_HOLDING_SLOTS&lt;/b&gt;&lt;br&gt;exit = obs × (1 − slippage) &amp;middot; net = gross − fee&lt;br&gt;realized P&amp;amp;L = net − cost basis" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="1235" width="360" height="66" as="geometry"/></mxCell><mxCell id="s14" value="&lt;b&gt;resultChecksum = StableHash(every outcome)&lt;/b&gt;&lt;br&gt;→ SimulationReport" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="200" y="1330" width="360" height="56" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;fontColor=#9a6a00;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="i1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="yes" style="edgeStyle=o