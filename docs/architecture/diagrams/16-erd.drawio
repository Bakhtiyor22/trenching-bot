<mxfile host="app.diagrams.net" type="device"><diagram id="16-erd" name="16 · Entity relationships (PostgreSQL, Hibernate ddl-auto)"><mxGraphModel dx="1370" dy="935" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1370" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;16 · Entity relationships (PostgreSQL, Hibernate ddl-auto)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="900" height="30" as="geometry"/></mxCell><mxCell id="RD" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;replay_datasets&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;PK id varchar(64) = dataset checksum&lt;br&gt;name · tracked_wallet · schema_version&lt;br&gt;transaction_count · observation_count&lt;br&gt;first_slot · last_slot · pairs (text)&lt;br&gt;snapshot text (canonical v1 JSON)&lt;br&gt;created_at · version" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="340" height="130" as="geometry"/></mxCell><mxCell id="SR" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;simulation_runs&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;PK id varchar(64) = run id&lt;br&gt;UQ engine_version + dataset_checksum + configuration_hash&lt;br&gt;tracked_wallet · result_checksum · quote_mint&lt;br&gt;configuration / dataset / report snapshots (text)&lt;br&gt;scenario · filled · rejected · open · closed counts&lt;br&gt;realized_pnl numeric(38,12) · created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="20" width="390" height="130" as="geometry"/></mxCell><mxCell id="WE" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;wallet_events&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;PK id = run_id:event_id&lt;br&gt;UQ run_id + signature + instruction_index&lt;br&gt;UQ run_id + event_id&lt;br&gt;slot · block_time · base / quote mint&lt;br&gt;base_delta / quote_delta numeric(20,0)&lt;br&gt;successful · supported_route · signer&lt;br&gt;side? · ignored_reason?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="340" height="145" as="geometry"/></mxCell><mxCell id="TI" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;trade_intents&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;PK id = runId:eventId:offset&lt;br&gt;UQ run_id + strategy name/version + source_event_id&lt;br&gt;   + entry_offset&lt;br&gt;entry_offset · creation_slot · target_slot&lt;br&gt;configuration_hash · notional numeric(38,12)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="390" height="115" as="geometry"/></mxCell><mxCell id="MO" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;market_observations&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;PK id = run_id:observation_id&lt;br&gt;UQ run_id + observation_id&lt;br&gt;slot · price_slot · observed_time&lt;br&gt;price numeric(78,38) + price_scale&lt;br&gt;liquidity_quote? + liquidity_scale?&lt;br&gt;source · source_event_id · commitment · quality" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="330" width="340" height="130" as="geometry"/></mxCell><mxCell id="PO" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;paper_orders&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;PK id = intent id&lt;br&gt;run_id · target_slot&lt;br&gt;status FILLED | REJECTED · rejection_reason?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="580" width="390" height="85" as="geometry"/></mxCell><mxCell id="PF" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;paper_fills&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;PK order_id&lt;br&gt;actual_slot · observation_id&lt;br&gt;execution_price numeric(78,38)&lt;br&gt;quantity · fee · cost_basis numeric(38,12)&lt;br&gt;fee_bps · slippage_bps · price_assumption" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="740" width="390" height="115" as="geometry"/></mxCell><mxCell id="PS" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;positions&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;PK id = intent id&lt;br&gt;intent_id · fill_order_id · entry_offset&lt;br&gt;state OPEN | CLOSED&lt;br&gt;close_slot? · close_observation_id? · exit_price?&lt;br&gt;gross / net proceeds · exit_fee · realized_pnl&lt;br&gt;close_reason? · exit_unavailable?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="640" width="340" height="130" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Every link is logical: rows match by id strings.&lt;br&gt;Hibernate creates only the PK and UQ keys shown.&lt;br&gt;No foreign keys, no CHECKs and no partial unique&lt;br&gt;index uq_positions_open_scenario exist in a&lt;br&gt;Hibernate-created database; that SQL lives only in docs/schema/." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffde7;strokeColor=#c9b458;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="340" height="150" as="geometry"/></mxCell><mxCell id="edge0" value="id = dataset_checksum" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="RD" target="SR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="run_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SR" target="WE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="140"/></Array></mxGeometry></mxCell><mxCell id="edge2" value="run_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SR" target="TI"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="run_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SR" target="MO"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="140"/></Array></mxGeometry></mxCell><mxCell id="edge4" value="event_id = source_event_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="WE" target="TI"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="TI" target="PO"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="id = order_id (FILLED only)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PO" target="PF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="order_id = fill_order_id" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="PF" target="PS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="observation_id (entry)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="MO" target="PF"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="486"/><mxPoint x="905" y="775"/></Array></mxGeometry></mxCell><mxCell id="edge9" value="close_observation_id (exit)" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="MO" target="PS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>