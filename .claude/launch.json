{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "env": { "BROWSER": "none" },
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "frontend-mocks",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "env": { "BROWSER": "none", "VITE_USE_MOCKS": "true" },
      "port": 5174,
      "url": "http://localhost:5174"
    },
    {
      "name": "console-public",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "serve:public"],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
