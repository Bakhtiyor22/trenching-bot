{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./src/**)",
      "Edit(./src/main/kotlin/**)",
      "Write(./src/main/kotlin/**)",
      "Edit(./src/test/kotlin/**)",
      "Write(./src/test/kotlin/**)",
      "Edit(./src/test/resources/**)",
      "Write(./src/test/resources/**)",
      "Read(./docs/**)",
      "Edit(./docs/**)",
      "Write(./docs/**)",

      "Bash(./gradlew compileKotlin:*)",
      "Bash(./gradlew compileTestKotlin:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew assemble:*)",
      "Bash(./gradlew build:*)",
      "PowerShell(.\\gradlew.bat compileKotlin:*)",
      "PowerShell(.\\gradlew.bat compileTestKotlin:*)",
      "PowerShell(.\\gradlew.bat test:*)",
      "PowerShell(.\\gradlew.bat assemble:*)",
      "PowerShell(.\\gradlew.bat build:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/*.env)",
      "Read(./**/*secret*)",
      "Read(./**/*keypair*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.config/solana/**)",

      "Edit(./.env)",
      "Edit(./**/*.env)",
      "Edit(./**/*secret*)",
      "Edit(./**/*keypair*)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",

      "Write(./.env)",
      "Write(./**/*.env)",
      "Write(./**/*secret*)",
      "Write(./**/*keypair*)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",

      "Bash(solana-keygen:*)",
      "PowerShell(solana-keygen:*)"
    ],
    "ask": [
      "Edit(./src/main/resources/application-prod.yml)",
      "Write(./src/main/resources/application-prod.yml)",
      "Edit(./src/main/resources/application-local.yml)",
      "Write(./src/main/resources/application-local.yml)",
      "Edit(./src/main/resources/db/migration/**)",
      "Write(./src/main/resources/db/migration/**)",
      "Edit(./build.gradle.kts)",
      "Edit(./settings.gradle.kts)",
      "Edit(./gradle.properties)",
      "Edit(./docker-compose.yml)",

      "Bash(psql:*)",
      "Bash(pgcli:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",
      "Bash(solana:*)",
      "Bash(spl-token:*)",
      "Bash(./gradlew bootRun:*)",
      "Bash(./gradlew bootTestRun:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",

      "PowerShell(psql:*)",
      "PowerShell(pgcli:*)",
      "PowerShell(pg_dump:*)",
      "PowerShell(pg_restore:*)",
      "PowerShell(solana:*)",
      "PowerShell(spl-token:*)",
      "PowerShell(.\\gradlew.bat bootRun:*)",
      "PowerShell(.\\gradlew.bat bootTestRun:*)",
      "PowerShell(docker:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git reset --hard:*)"
    ]
  }
}
