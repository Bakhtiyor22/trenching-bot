                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.be.oneOf([200,409]); });",
                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });",
                  "pm.test(\"Address result or unconfigured envelope\", function () { const result = pm.response.json(); if (pm.response.code === 409) pm.expect(result.code).to.equal(\"SOLANA_NOT_CONFIGURED\"); else pm.expect(result.outcome).to.be.a(\"string\"); });"
