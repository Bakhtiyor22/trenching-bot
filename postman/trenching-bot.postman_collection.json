{
  "info": {
    "name": "Trenching Bot — Application API",
    "description": "Local application health and console API checks. Console operations persist replay datasets/runs. Solana status is passive; the optional probe folder is skipped unless allowSolanaProbe=true. No provider credentials are exported.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "expectHealthDetails",
      "value": "true",
      "type": "string"
    },
    {
      "key": "datasetId",
      "value": "",
      "type": "string"
    },
    {
      "key": "datasetPair",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runConfig",
      "value": "{}",
      "type": "string"
    },
    {
      "key": "allowSolanaProbe",
      "value": "false",
      "type": "string"
    },
    {
      "key": "address",
      "value": "So11111111111111111111111111111111111111112",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Application endpoints",
      "item": [
        {
          "name": "Discover Actuator endpoints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/actuator",
            "description": "Lists exposed Actuator links."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health and info endpoints are exposed\", function () { const links = pm.response.json()._links; pm.expect(links).to.be.an(\"object\"); [\"self\", \"health\", \"info\"].forEach(function (key) { pm.expect(links[key].href).to.be.a(\"string\").and.not.empty; }); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Overall health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Overall health includes the database indicator. Set expectHealthDetails=false when testing a profile that hides component details."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Application is UP\", function () { pm.expect(pm.response.json().status).to.equal(\"UP\"); });",
                  "if (pm.variables.get(\"expectHealthDetails\") === \"true\") {",
                  "  pm.test(\"PostgreSQL component is UP\", function () { pm.expect(pm.response.json().components.db.status).to.equal(\"UP\"); });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/actuator/health/liveness",
            "description": "Checks process liveness. This probe does not independently verify PostgreSQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Liveness is UP\", function () { pm.expect(pm.response.json().status).to.equal(\"UP\"); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/actuator/health/readiness",
            "description": "Checks Spring readiness state. Use overall health or the local database check for database connectivity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Readiness is UP\", function () { pm.expect(pm.response.json().status).to.equal(\"UP\"); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Application info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/actuator/info",
            "description": "An empty JSON object is valid: build/git info contributors are not currently configured."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": []
              }
            }
          ],
          "response": []
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/(?:json|vnd\\.spring-boot\\.actuator\\.v\\d+\\+json)/i); });",
              "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Local only — PostgreSQL details",
      "description": "Run with the local profile only. Production hides components/details; omit this folder when checking production.",
      "item": [
        {
          "name": "PostgreSQL health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/actuator/health/db",
            "description": "Verifies the real database health indicator, including the PostgreSQL product name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Database is UP\", function () { pm.expect(pm.response.json().status).to.equal(\"UP\"); });",
                  "pm.test(\"Database is PostgreSQL\", function () { pm.expect(pm.response.json().details.database).to.equal(\"PostgreSQL\"); });"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/application\\/(?:json|vnd\\.spring-boot\\.actuator\\.v\\d+\\+json)/i); });",
              "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Console API",
      "description": "Run in order with the console enabled on the local profile. Imports the sample and starts an immutable persisted experiment; no live RPC requests.",
      "item": [
        {
          "name": "Default simulation config and limits",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/config/defaults",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });",
                  "const defaults = pm.response.json().defaults;",
                  "pm.test(\"Notional stays an exact string\", function () { pm.expect(defaults.notional).to.equal(\"100.000000000000\"); });",
                  "const {strategyName, strategyVersion, ...config} = defaults; pm.collectionVariables.set(\"runConfig\", JSON.stringify(config));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Import weekly sample",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/datasets/samples/weekly-buy-v1",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });",
                  "const registration = pm.response.json();",
                  "pm.test(\"Dataset registration matches status\", function () { pm.expect(registration.created).to.equal(pm.response.code === 201); pm.expect(registration.dataset.id).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"datasetId\", registration.dataset.id);",
                  "if (registration.dataset.pairs.length) { const pair = registration.dataset.pairs[0]; pm.collectionVariables.set(\"datasetPair\", encodeURIComponent(pair.base + \"/\" + pair.quote)); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Upload replay dataset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/datasets",
            "description": "For Postman desktop choose the bundled sample file and permit file access; Newman resolves this repository-relative path from the repository root. Limit:20MB, UTF-8 JSON.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "src/main/resources/replay/samples/weekly-buy-v1.json"
                },
                {
                  "key": "name",
                  "type": "text",
                  "value": "Weekly buy sample"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });",
                  "const registration = pm.response.json();",
                  "pm.test(\"Dataset registration matches status\", function () { pm.expect(registration.created).to.equal(pm.response.code === 201); pm.expect(registration.dataset.id).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"datasetId\", registration.dataset.id);",
                  "if (registration.dataset.pairs.length) { const pair = registration.dataset.pairs[0]; pm.collectionVariables.set(\"datasetPair\", encodeURIComponent(pair.base + \"/\" + pair.quote)); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List datasets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/datasets?page=0&size=20",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });",
                  "pm.test(\"Page has items and pagination\", function () { const page = pm.response.json(); pm.expect(page.items).to.be.an(\"array\"); [\"page\", \"size\", \"total\"].forEach(key => pm.expect(page[key]).to.be.a(\"number\")); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Dataset summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/datasets/{{datasetId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });",
                  "pm.test(\"Dataset identity\", function () { pm.expect(pm.response.json().id).to.equal(pm.variables.get(\"datasetId\")); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Dataset observations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/datasets/{{datasetId}}/observations?pair={{datasetPair}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON array response\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });",
                  "pm.test(\"Prices are decimal strings\", function () { pm.response.json().forEach(item => pm.expect(item.price).to.be.a(\"string\")); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Start default run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/runs",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"datasetId\":\"{{datasetId}}\",\"config\":{{runConfig}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP status\", function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });",
                  "const start = pm.response.json(); pm.collectionVariables.set(\"runId\", start.run.id);",
                  "pm.test(\"Created status and exact sample summary\", function () { pm.expect(start.created).to.equal(pm.response.code === 201); pm.expect(start.run.realizedPnl).to.equal(\"26.089701492540\"); pm.expect(start.run.filledCount).to.equal(3); pm.expect(start.run.closedCount).to.equal(3); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Repeat run idempotently",
          "request": {
            "method": "POST",
            "header": [
