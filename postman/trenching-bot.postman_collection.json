                  "pm.test(\"JSON content type\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "pm.test(\"JSON object response\", function () { pm.expect(pm.response.json()).to.be.an(\"object\"); });",
                  "pm.test(\"Field error envelope\", function () { const error = pm.response.json(); pm.expect(error.code).to.equal(\"CONFIG_INVALID\"); pm.expect(error.fields.feeBps).to.be.a(\"string\"); });"
                ]
